mainmenu "RIS Transceiver"

source "Kconfig.zephyr"

menu "RIS Transceiver options"

# Single firmware image: TX/RX are runtime roles (ble-runtime-0004), so there is no
# build-time role selection here.

config TRANSCEIVER_BLINK_INTERVAL_MS
	int "Role-identification LED blink interval in milliseconds"
	default 500
	range 100 5000

endmenu
